# Names only. Real values live in <repo>/.env (gitignored).
SUPABASE_DB_URL=      # Postgres connection string (service-level access to the catalog + change log)
ANTHROPIC_API_KEY=    # the merchant agent (server-side only; never sent to the page)
CART_ID=7             # the cart shown live in the console
MERCHANT_MODEL=       # optional, default claude-opus-5-5
MERCHANT_EFFORT=      # optional, default low
STORE_TZ=             # optional, default America/Los_Angeles
