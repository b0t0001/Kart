# KART shared environment file: copy to .env at the repo root (gitignored) and fill in your own values.
# Every component loads <repo>/.env, or the file named by KART_ENV_FILE. Names only here; never commit values.
# Per-component subsets: pi/.env.example, agent/.env.example, backend/.env.example, merchant/.env.example,
# ios/Config.example.xcconfig. See docs/CONTRACT.md §6 for who may hold which key.

# ── Supabase: public values (safe on the Pi, the iPad and the voice agent) ──
SUPABASE_URL=                 # https://<project>.supabase.co, or http://127.0.0.1:54321 for the local stack
SUPABASE_ANON_KEY=            # public anon key; RLS allows reads, and writes only through the RPCs

# ── Supabase: admin values (backend scripts on a laptop only; never on the Pi or the iPad) ──
SUPABASE_SERVICE_ROLE_KEY=    # backend/go_live.sh
SUPABASE_DB_URL=              # Postgres connection string: backend/db.py, backend/members.py, merchant/server.py, backend/e2e
SUPABASE_PROJECT_REF=         # backend/deploy_functions.sh (Edge Function deploy)
SUPABASE_ACCESS_TOKEN=        # backend/deploy_functions.sh; a personal access token (account-wide: revoke when done)

# ── Model and voice providers ──
ANTHROPIC_API_KEY=            # pi/ vision fallback, agent/ (set on Cartesia with `cartesia env set`), merchant/
CARTESIA_API_KEY=             # pushed to the voice-token Edge Function as a secret; never shipped to the iPad
CARTESIA_AGENT_ID=            # the deployed Line agent's id (agent/scripts/deploy-line.sh writes it)

# ── Which cart this machine drives ──
CART_ID=7

# ── Optional tuning ──
KART_MODEL=claude-opus-5-5    # agent/: conversation model
KART_EFFORT=low               # agent/: effort for the conversation model
KART_BARGE_IN=on              # agent/: "off" makes everything Kart says uninterruptible (loud floors)
MERCHANT_MODEL=               # merchant/: default claude-opus-5-5
MERCHANT_EFFORT=              # merchant/: default low
STORE_TZ=                     # merchant/: default America/Los_Angeles
KART_TEAM_ID=                 # ios/scripts/make-config.sh: Apple signing team for a real iPad (optional)

# ── Tests only ──
# KART_ENV_FILE=              # load a different env file instead of <repo>/.env
# KART_TEST_PG=postgresql://postgres@localhost:54329/postgres   # backend/tests throwaway Postgres
# KART_E2E=1                  # opt in to pi/tests/test_e2e_supabase.py
# KART_IT=1                   # opt in to agent/ live tests against Supabase
# KART_E2E_ALLOW_HOSTED=1     # let backend/e2e run against a hosted project (its checkouts drain shared stock)
