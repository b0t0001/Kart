# Names only. Real values live in /Users/dylan/Documents/GitHub/kart/.env (gitignored).
SUPABASE_URL=                 # https://<project>.supabase.co  (simulate_demo.py REST mode)
SUPABASE_ANON_KEY=            # public key the Pi and iPad use
SUPABASE_SERVICE_ROLE_KEY=    # server-side only (merchant console)
SUPABASE_DB_URL=              # Postgres connection string, for db.py (migrations + seeding)
SUPABASE_PROJECT_REF=         # the <project> part of SUPABASE_URL, for deploy_functions.sh
SUPABASE_ACCESS_TOKEN=        # personal access token (supabase.com/dashboard/account/tokens), for deploy_functions.sh
CARTESIA_API_KEY=             # pushed to Supabase as an Edge Function secret; never shipped to the iPad
CARTESIA_AGENT_ID=            # the iPad chat's Line agent; "pending" until it is deployed
ANTHROPIC_API_KEY=            # merchant agent
CART_ID=7
